<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../QtChungus/QtChungus.csproj" Condition="$(UsePackage) != 'true'" />
    <PackageReference Include="QtChungus" Version="0.0.1" Condition="$(UsePackage) == 'true'" />
  </ItemGroup>
  <Import Project="../QtChungus/QtChungus.targets" Condition="$(UsePackage) != 'true'" />

  <PropertyGroup>
    <QtGlueDirectory Condition="$(UsePackage) != 'true'">../QtGlue/bin/</QtGlueDirectory>
  </PropertyGroup>
</Project>