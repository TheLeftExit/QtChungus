<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <QtGlueShared>false</QtGlueShared>

    <PackageId Condition="'$(QtGlueShared)' == 'true'">QtChungus.Shared</PackageId>
    <PackageId Condition="'$(QtGlueShared)' != 'true'">QtChungus.Static</PackageId>
    <Version>0.7</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="./bld/libQtGlue.so" Condition="'$(QtGlueShared)' == 'true'">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native</PackagePath>
    </None>

    <None Include="./bld/libQtGlue.a" Condition="'$(QtGlueShared)' != 'true'">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>

    <None Include="./QtChungus.Static.props" Condition="'$(QtGlueShared)' != 'true'">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="BuildQtGlue" BeforeTargets="GenerateNuspec">
    <Exec Command="rm -rf ./bld" />
    <Exec Command="cmake -S ./QtGlue -B ./bld -D QTGLUE_SHARED=OFF"
      Condition="'$(QtGlueShared)' != 'true'" />
    <Exec Command="cmake -S ./QtGlue -B ./bld -D QTGLUE_SHARED=ON"
      Condition="'$(QtGlueShared)' == 'true'" />
    <Exec Command="cmake --build ./bld" />
  </Target>

</Project>